# Salin menjadi .env di server backend. JANGAN commit file .env.
PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Asal yang boleh memanggil API (WebView Capacitor memakai https://localhost)
ALLOWED_ORIGINS=https://localhost,capacitor://localhost
RATE_LIMIT_PER_MIN=20
# Isi 1 bila di belakang proxy HTTPS (Render, Railway, Fly, Nginx)
TRUST_PROXY=0
PORT=3000
# Suara AI (Gemini TTS), dicoba berurutan sampai ada yang berhasil. Bisa diganti.
# TTS_MODELS=gemini-3.8-flash-lite-tts,gemini-3.8-flash-tts,gemini-2.5-flash-preview-tts
